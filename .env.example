# ─── Royal Rose production environment ───────────────────────────────────
# Copy to `.env` on the server (NEVER commit .env). chmod 600 .env.
# Validated against the actual process.env references in the codebase.

# ═════════ REQUIRED ═════════════════════════════════════════════════════
# The app refuses to boot or fails first request without these.

# Database — Prisma reads DATABASE_URL directly. In docker-compose it's
# synthesised from POSTGRES_USER/PASSWORD/DB; locally set DATABASE_URL.
POSTGRES_USER=royalrose
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=royalrose
DATABASE_URL=postgresql://royalrose:change-me@localhost:5432/royalrose

# Cookie sealing key — `openssl rand -hex 32`. Server fails to boot when
# unset or shorter than 16 chars (see app/lib/auth.server.ts).
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Public origin used for Stripe success_url / cancel_url. MUST match the
# canonical host Nginx serves under — a mismatch makes the browser drop
# cart-storage on the return trip (different origin = different storage).
BASE_URL=https://royalrose.example.com

# Google Sign-In client ID. Required: app/root.tsx throws on missing.
# Even if you don't want Google login enabled in your UI, this still has
# to be set or every page errors at the loader.
PUBLIC_GOOGLE_CLIENT_ID=

# Stripe live keys. The app auto-switches to dev-mode bypass when
# STRIPE_SECRET_KEY is empty or contains "placeholder" — convenient for
# local dev, MUST be set in production or no real payment can happen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ═════════ STRONGLY RECOMMENDED ════════════════════════════════════════
# App boots without these, but key features silently degrade.

# SMTP — without these the admin "new order" email is skipped (logged to
# console). Customer confirmation emails go through the same transporter.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Royal Rose <hello@royalrose.example.com>"

# Where admin order notifications go when the in-DB SiteSetting is empty.
# Prefer setting the recipient in /admin/settings; this is a fallback.
NOTIFICATION_EMAIL=admin@royalrose.example.com

# ═════════ OPTIONAL ════════════════════════════════════════════════════
# Sensible defaults exist for these.

# Node mode — usually set by your process manager / docker. Setting it to
# "production" enables the secure cookie flag.
NODE_ENV=production

# Override the uploads directory. Default ./uploads relative to cwd.
# UPLOADS_DIR=/var/lib/royalrose/uploads

# scripts/uploads-prune.ts only — minimum age in days before a stale
# upload is deleted. Defaults to 7 if unset.
# MIN_AGE_DAYS=7

# ═════════ DEPRECATED / UNUSED ═════════════════════════════════════════
# Listed only so old runbooks don't surprise anyone. Safe to omit.

# JWT_SECRET is read by app/lib/auth.servercopy.ts which is no longer
# imported anywhere. Remove from your .env when convenient.
# JWT_SECRET=
