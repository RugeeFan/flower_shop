# ─── Royal Rose production environment ───────────────────────────────────
# Copy to `.env` on the server (NEVER commit .env). chmod 600 .env.
#
# Required by docker-compose.yml + the app.

# ── Database (consumed by both `db` service and `app` service) ──────────
# docker-compose synthesises DATABASE_URL from these three for the app.
POSTGRES_USER=royalrose
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=royalrose

# ── App secrets ─────────────────────────────────────────────────────────
# Cookie sealing — generate fresh:  openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32
# Legacy JWT secret (not currently used but the auth module reads it)
JWT_SECRET=replace-with-openssl-rand-hex-32

# Public origin used for Stripe success_url / cancel_url + absolute links.
# In production: your Royal Rose domain.
BASE_URL=https://royalrose.example.com

# ── Stripe ──────────────────────────────────────────────────────────────
# Until you set a real key, the app runs in dev mode (Stripe bypassed).
# In production:
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_PUBLIC_KEY=pk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
# Leave empty (or "placeholder") to keep dev-mode bypass active.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google OAuth (optional) ─────────────────────────────────────────────
PUBLIC_GOOGLE_CLIENT_ID=

# ── Email notifications (optional; falls back to console.log) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Royal Rose <hello@royalrose.example.com>"
NOTIFICATION_EMAIL=admin@royalrose.example.com
