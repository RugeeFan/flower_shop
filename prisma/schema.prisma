generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-1.1.x", "native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  name      String?
  orders    Order[]
  isAdmin   Boolean  @default(false)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[] @relation("ProductCategories")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  imgUrl      String
  categories  Category[]  @relation("ProductCategories")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  OrderItem   OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  recipientName   String
  recipientEmail  String
  recipientPhone  String? // ✅ 新增字段
  address         String
  postcode        String
  deliveryDate    DateTime
  message         String? // 可选的卡片信息
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  stripeSessionId String? // Stripe session id for tracking
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade) // ✅ 关键改动
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Float // 下单时的商品单价快照
}

model PageContent {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // 比如 'home-banner', 'home-announcement', 'about-page-intro'
  title     String?
  subtitle  String?
  content   String? // 富文本或者普通正文内容
  imageUrl  String[] // 可选，比如 Banner 图片地址
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingZone {
  id       Int    @id @default(autoincrement())
  postcode String
  suburb   String
  km       Float
  small    Float
  medium   Float
  large    Float

  @@index([postcode, suburb]) // 优化根据用户地址匹配查询
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}
